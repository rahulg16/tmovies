{
  "name": "tmovies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@tanstack/react-query": "^5.104.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.3.0"
  },
  "overrides": {
    "react-is": "^18.3.1"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "vite build && vite build --ssr server/entry-server.jsx --outDir dist/server",
    "preview": "NODE_ENV=production node server/index.js",
    "test": "jest --env=./src/test-utils/jestEnv.cjs",
    "test:ci": "CI=true jest --env=./src/test-utils/jestEnv.cjs --watchAll=false",
    "test:coverage": "CI=true jest --env=./src/test-utils/jestEnv.cjs --watchAll=false --coverage"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "resetMocks": true,
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|svg)$": "<rootDir>/src/test-utils/fileMock.js",
      "^@bundled-es-modules/cookie$": "<rootDir>/node_modules/@bundled-es-modules/cookie/index-cjs.cjs",
      "^@bundled-es-modules/statuses$": "<rootDir>/node_modules/@bundled-es-modules/statuses/index-cjs.cjs"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/entry-client.jsx",
      "!src/entry-server.jsx",
      "!src/test-utils/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 75,
        "lines": 80
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@mui/codemod": "^9.5.0",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-jest": "^27.5.1",
    "jest": "^27.5.1",
    "jest-environment-jsdom": "^27.5.1",
    "msw": "2.11.1",
    "typescript": "^4.9.5",
    "vite": "^5.4.0"
  }
}
